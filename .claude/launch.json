{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LLM_MODEL=anthropic/claude-haiku-5-5",
        "LLM_FALLBACKS=",
        "LLM_REASONING_EFFORT=",
        "uv", "run", "--env-file", ".env",
        "uvicorn", "backend.app.api:app", "--port", "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
