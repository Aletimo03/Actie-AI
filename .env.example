# Copy to .env and fill in real values. Never commit .env.

# Postgres (docker compose)
POSTGRES_USER=actie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=actie
POSTGRES_PORT=5432
DATABASE_URL=postgresql://actie:change-me@localhost:5432/actie

# Embeddings (Ollama, local; only ingestion and the retrieval eval use them)
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# LLM (LiteLLM model strings). The live site uses Claude Haiku; about $0.005 per assessment.
LLM_MODEL=anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=
LLM_REASONING_EFFORT=
# Comma-separated models to move to when one hits a daily cap; per-minute limits are waited out.
LLM_FALLBACKS=
# Development only: keep validated replies on disk so re-runs of the same evals cost no
# tokens (free tiers also cap tokens per day). Never set it on the live site.
LLM_CACHE_DIR=

# API cost limits (backend/app/quota.py): new assessments per client per hour, and for
# everyone per UTC day. The secret keys the hash that stands in for client IPs; set it
# (e.g. openssl rand -hex 32) wherever more than one API process runs.
QUOTA_PER_HOUR=10
QUOTA_PER_DAY=50
QUOTA_SECRET=

# Offline alternative (Ollama, ~8 GB of RAM while loaded):
# LLM_MODEL=ollama_chat/gemma4:12b
# LLM_REASONING_EFFORT=none
# LLM_NUM_CTX=16384
