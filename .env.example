# Copy to .env and fill in real values. Never commit .env.

# Postgres (docker compose)
POSTGRES_USER=actie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=actie
POSTGRES_PORT=5432
DATABASE_URL=postgresql://actie:change-me@localhost:5432/actie

# Embeddings (Ollama, local)
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# LLM (LiteLLM model strings). Default: Groq, with Zero Data Retention turned on in
# console.groq.com > Settings > Data Controls. Free tier: 8000 tokens/minute.
LLM_MODEL=groq/openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
# Used when a model hits its daily cap (Groq: 200k tokens/day); per-minute limits are waited out.
LLM_FALLBACKS=cloudflare/@cf/openai/gpt-oss-120b
GROQ_API_KEY=
# Cloudflare Workers AI, free plan: 10,000 neurons/day (reset 00:00 UTC). Token: My Profile >
# API Tokens > "Workers AI" permission only; the account id is in the dashboard URL.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# Development only: keep validated replies on disk so re-runs of the same evals cost no
# tokens (free tiers also cap tokens per day). Never set it on the live site.
LLM_CACHE_DIR=

# Offline alternative (Ollama, ~8 GB of RAM while loaded):
# LLM_MODEL=ollama_chat/gemma4:12b
# LLM_REASONING_EFFORT=none
# LLM_NUM_CTX=16384
